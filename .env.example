# --- Firebase client (browser sign-in) — from your Firebase project settings ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
# Paste the service-account JSON as a single line, OR set
# GOOGLE_APPLICATION_CREDENTIALS to the path of the JSON file instead.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Downloads ---
# Signs the 10-minute download links.
DOWNLOAD_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Admin Passcode Login (Numeric Code) ---
ADMIN_PASSCODE=192167

# --- Admin account (created by `npm run seed` in Firebase Auth) ---
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Site ---
NEXT_PUBLIC_SITE_NAME=S_de_sign prompts
